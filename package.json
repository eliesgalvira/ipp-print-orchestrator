{
  "name": "ipp-print-orchestrator",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "tsc --build --pretty false",
    "typecheck": "tsc -p packages/shared/tsconfig.json --pretty false --noEmit && tsc -p packages/ipp/tsconfig.json --pretty false --noEmit && tsc -p packages/testkit/tsconfig.json --pretty false --noEmit && tsc -p apps/agent/tsconfig.json --pretty false --noEmit",
    "test": "vitest run && bun run test:nu",
    "test:nu": "nu scripts/tests.nu",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "smoke:local": "nu scripts/smoke-test-local.nu",
    "smoke:live-pi": "nu scripts/smoke-test-live-pi.nu",
    "deploy:live-pi": "nu scripts/deploy-live-pi.nu",
    "debug-ipp-printer-attributes:live-pi": "nu scripts/debug-ipp-printer-attributes-live-pi.nu",
    "diagnose-usb-hotplug:live-pi": "nu scripts/diagnose-usb-hotplug-live-pi.nu",
    "install-systemd:live-pi": "nu scripts/install-systemd-live-pi.nu",
    "update:live-pi": "nu scripts/update-packages-live-pi.nu"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@effect/language-service": "^0.79.0",
    "@effect/vitest": "4.0.0-beta.36",
    "@types/node": "^25.4.0",
    "effect-solutions": "^0.5.2",
    "fast-check": "^4.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.36",
    "effect": "^4.0.0-beta.36"
  }
}
