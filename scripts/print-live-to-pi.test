# The Print-Job shape Android sends (ADR-0001), then wait until CUPS finishes the job.
{
  NAME "Print $job-name"
  OPERATION Print-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR naturalLanguage attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name $user
  ATTR name job-name $job-name
  ATTR mimeMediaType document-format application/pdf
  GROUP job-attributes-tag
  ATTR integer copies 1
  ATTR keyword print-scaling none
  ATTR enum orientation-requested 3
  ATTR keyword sides one-sided
  ATTR keyword print-color-mode monochrome
  ATTR keyword media iso_a4_210x297mm
  FILE $filename
  STATUS successful-ok
  EXPECT job-id OF-TYPE integer WITH-VALUE >0
}
{
  NAME "Wait for job $job-id"
  OPERATION Get-Job-Attributes
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR naturalLanguage attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job-id
  ATTR name requesting-user-name $user
  STATUS successful-ok
  EXPECT job-state OF-TYPE enum WITH-VALUE >5 REPEAT-NO-MATCH
}
{
  NAME "Job $job-id completed"
  OPERATION Get-Job-Attributes
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR naturalLanguage attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job-id
  ATTR name requesting-user-name $user
  STATUS successful-ok
  EXPECT job-state OF-TYPE enum WITH-VALUE 9
  DISPLAY job-state
  DISPLAY job-state-reasons
}
